generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

model Category {
  id                String        @id @default(uuid()) @db.Uuid
  websiteCategoryId Int           @unique @map("website_category_id")
  name              String?       @db.VarChar(255)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  products          Product[]
  subCategories     SubCategory[]

  @@index([name])
  @@map("categories")
}

model SubCategory {
  id                   String   @id @default(uuid()) @db.Uuid
  websiteSubCategoryId Int      @unique @map("website_sub_category_id")
  name                 String?  @db.VarChar(255)
  categoryRecordId     String   @map("category_record_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  category             Category @relation(fields: [categoryRecordId], references: [id], onDelete: Cascade)
  products             Product[]

  @@index([categoryRecordId])
  @@index([name])
  @@map("sub_categories")
}

model Product {
  id                String             @id @default(uuid()) @db.Uuid
  websiteProductId  Int                @unique @map("website_product_id")
  productName       String             @map("product_name") @db.VarChar(255)
  productCode       String             @map("product_code") @db.VarChar(100)
  slug              String             @unique @db.VarChar(255)
  productDetails    String?            @map("product_details") @db.Text
  productImage      String?            @map("product_image") @db.Text
  categoryId        Int?               @map("website_category_id")
  categoryName      String?            @map("category_name") @db.VarChar(255)
  subCategoryId     Int?               @map("website_sub_category_id")
  subCategoryName   String?            @map("sub_category_name") @db.VarChar(255)
  colorName         String?            @map("color_name") @db.VarChar(100)
  productStatus     String             @default("active") @map("product_status") @db.VarChar(50)
  sellPrice         Decimal            @map("sell_price") @db.Decimal(12, 2)
  discountPrice     Decimal?           @map("discount_price") @db.Decimal(12, 2)
  flashSellPrice    Decimal?           @map("flash_sell_price") @db.Decimal(12, 2)
  isPreOrder        Boolean            @default(false) @map("is_pre_order")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  lastSyncedAt      DateTime?          @map("last_synced_at")
  presentInFeed     Boolean            @default(true) @map("present_in_feed")
  missingFromFeedAt DateTime?          @map("missing_from_feed_at")
  category          Category?          @relation(fields: [categoryId], references: [websiteCategoryId], onDelete: SetNull, onUpdate: Cascade)
  subCategory       SubCategory?       @relation(fields: [subCategoryId], references: [websiteSubCategoryId], onDelete: SetNull, onUpdate: Cascade)
  variations        ProductVariation[]
  orderItems        OrderItem[]

  @@index([productCode])
  @@index([productName])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([productStatus])
  @@index([isPreOrder])
  @@index([presentInFeed])
  @@map("products")
}

model ProductVariation {
  id                 String   @id @default(uuid()) @db.Uuid
  websiteVariationId Int      @unique @map("website_variation_id")
  productId          String   @map("product_id") @db.Uuid
  websiteSizeId      Int      @map("website_size_id")
  sizeName           String   @map("size_name") @db.VarChar(50)
  stockQuantity      Int      @default(0) @map("stock_quantity")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  lastSyncedAt       DateTime? @map("last_synced_at")
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]

  @@index([productId, active])
  @@index([websiteSizeId])
  @@index([sizeName])
  @@index([stockQuantity])
  @@map("product_variations")
}

model KnowledgeBase {
  id        String   @id @default(uuid()) @db.Uuid
  content   String   @db.Text
  version   Int      @unique
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("knowledge_bases")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model QuickReply {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(120)
  message   String   @db.Text
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled, sortOrder])
  @@map("quick_replies")
}

model SystemLog {
  id             String   @id @default(uuid()) @db.Uuid
  level          LogLevel @default(INFO)
  type           String   @db.VarChar(100)
  event          String?  @db.VarChar(100)
  module         String?  @db.VarChar(100)
  message        String   @db.Text
  requestId      String?  @map("request_id") @db.VarChar(128)
  conversationId String?  @map("conversation_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([event, createdAt])
  @@index([module, createdAt])
  @@index([requestId])
  @@index([conversationId, createdAt])
  @@index([customerId, createdAt])
  @@index([level, createdAt])
  @@index([createdAt])
  @@map("system_logs")
}

enum ConversationChannel {
  WEB       @map("web")
  MESSENGER @map("messenger")
  ADMIN     @map("admin")
  TEST      @map("test")
}

enum ConversationStatus {
  ACTIVE @map("active")
  CLOSED @map("closed")
  HUMAN  @map("human")
}

enum MessageRole {
  USER      @map("user")
  ASSISTANT @map("assistant")
  SYSTEM    @map("system")
  HUMAN     @map("human")
}

enum CustomerJourneyState {
  NEW                    @map("new")
  ENGAGED                @map("engaged")
  PRODUCT_INTEREST       @map("product_interest")
  ORDER_STARTED          @map("order_started")
  AWAITING_CUSTOMER_INFO @map("awaiting_customer_info")
  AWAITING_CONFIRMATION  @map("awaiting_confirmation")
  ORDER_CONFIRMED        @map("order_confirmed")
  ORDER_SUBMITTED        @map("order_submitted")
  POST_ORDER             @map("post_order")
  COMPLETED              @map("completed")
  CANCELLED              @map("cancelled")
  HUMAN_SUPPORT          @map("human_support")
}

enum CustomerActivityType {
  MESSAGE_RECEIVED             @map("message_received")
  PRODUCT_VIEWED               @map("product_viewed")
  PRODUCT_INTEREST             @map("product_interest")
  PRODUCT_SELECTED             @map("product_selected")
  ORDER_STARTED                @map("order_started")
  CUSTOMER_INFO_PROVIDED       @map("customer_info_provided")
  ORDER_DRAFT_CREATED          @map("order_draft_created")
  ORDER_CONFIRMATION_REQUESTED @map("order_confirmation_requested")
  ORDER_CONFIRMED              @map("order_confirmed")
  ORDER_SUBMITTED              @map("order_submitted")
  ORDER_CANCELLED              @map("order_cancelled")
  ORDER_COMPLETED              @map("order_completed")
  HUMAN_HANDOVER               @map("human_handover")
  CONVERSATION_CLOSED          @map("conversation_closed")
}

enum FollowUpType {
  ORDER_CONFIRMATION_REMINDER @map("order_confirmation_reminder")
  ABANDONED_ORDER             @map("abandoned_order")
  CUSTOMER_REQUESTED_FOLLOWUP @map("customer_requested_followup")
  POST_ORDER                  @map("post_order")
  REVIEW_REQUEST              @map("review_request")
  REORDER                     @map("reorder")
}

enum FollowUpStatus {
  PENDING      @map("pending")
  PROCESSING   @map("processing")
  SENT         @map("sent")
  CANCELLED    @map("cancelled")
  FAILED       @map("failed")
  BLOCKED      @map("blocked")
  NOT_ELIGIBLE @map("not_eligible")
}

enum MessageType {
  TEXT   @map("text")
  IMAGE  @map("image")
  AUDIO  @map("audio")
  SYSTEM @map("system")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  externalId     String?        @unique @map("external_id") @db.VarChar(255)
  name           String?        @db.VarChar(255)
  phone          String?        @db.VarChar(50)
  email          String?        @db.VarChar(320)
  address        String?        @db.Text
  platform       String?        @db.VarChar(50)
  platformUserId String?        @map("platform_user_id") @db.VarChar(255)
  language       String?        @db.VarChar(20)
  metadata              Json?                @db.JsonB
  journeyState          CustomerJourneyState @default(NEW) @map("journey_state")
  automationOptOut      Boolean               @default(false) @map("automation_opt_out")
  preferredSize         String?               @map("preferred_size") @db.VarChar(50)
  preferredCategory     String?               @map("preferred_category") @db.VarChar(100)
  preferredColor        String?               @map("preferred_color") @db.VarChar(100)
  lastActivityAt        DateTime               @default(now()) @map("last_activity_at")
  lastConversationAt    DateTime?              @map("last_conversation_at")
  lastOrderAt           DateTime?              @map("last_order_at")
  lastProductInterestAt DateTime?              @map("last_product_interest_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  conversations         Conversation[]
  messages              Message[]
  orders                Order[]
  activities            CustomerActivity[]
  followUps             FollowUp[]

  @@unique([platform, platformUserId])
  @@index([platformUserId])
  @@index([createdAt])
  @@index([journeyState, lastActivityAt])
  @@map("customers")
}

model CustomerActivity {
  id             String               @id @default(uuid()) @db.Uuid
  customerId     String               @map("customer_id") @db.Uuid
  conversationId String?              @map("conversation_id") @db.Uuid
  orderId        String?              @map("order_id") @db.Uuid
  type           CustomerActivityType
  summary        String               @db.VarChar(500)
  metadata       Json?                @db.JsonB
  createdAt      DateTime             @default(now()) @map("created_at")
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation   Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  order          Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([conversationId, createdAt])
  @@index([orderId, createdAt])
  @@map("customer_activities")
}

model FollowUp {
  id             String         @id @default(uuid()) @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  orderId        String?        @map("order_id") @db.Uuid
  type           FollowUpType
  scheduledAt    DateTime       @map("scheduled_at")
  status         FollowUpStatus @default(PENDING)
  payload        Json           @db.JsonB
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(255)
  attempts       Int            @default(0)
  sentAt         DateTime?      @map("sent_at")
  cancelledAt    DateTime?      @map("cancelled_at")
  failureReason  String?        @map("failure_reason") @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([customerId, createdAt])
  @@index([conversationId, status])
  @@map("follow_ups")
}

model FollowUpTemplate {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(100)
  trigger   FollowUpType @unique
  delayMinutes Int       @map("delay_minutes")
  message   String       @db.VarChar(2000)
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("follow_up_templates")
}

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  channel       ConversationChannel
  status        ConversationStatus @default(ACTIVE)
  title                 String?            @db.VarChar(255)
  assignedTo            String?            @map("assigned_to") @db.VarChar(100)
  unreadForAdmin        Boolean            @default(false) @map("unread_for_admin")
  consecutiveAiFailures Int                @default(0) @map("consecutive_ai_failures")
  salesState            String             @default("DISCOVERY") @map("sales_state") @db.VarChar(50)
  conversationSummary   Json?              @map("conversation_summary") @db.JsonB
  summaryUpdatedAt      DateTime?          @map("summary_updated_at")
  lastMessageAt         DateTime           @default(now()) @map("last_message_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages      Message[]
  orders        Order[]
  handovers     ConversationHandover[]
  notifications AdminNotification[]
  activities    CustomerActivity[]
  followUps     FollowUp[]

  @@index([customerId, status, lastMessageAt])
  @@index([status, assignedTo, lastMessageAt])
  @@index([unreadForAdmin, lastMessageAt])
  @@index([channel, status, lastMessageAt])
  @@index([salesState, lastMessageAt])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  customerId     String?      @map("customer_id") @db.Uuid
  role           MessageRole
  content        String       @db.Text
  messageType    MessageType  @default(TEXT) @map("message_type")
  metadata          Json?        @db.JsonB
  externalMessageId String?      @unique @map("external_message_id") @db.VarChar(255)
  createdAt         DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("messages")
}

enum HandoverReason {
  CUSTOMER_REQUESTED_HUMAN @map("customer_requested_human")
  AI_UNCERTAIN             @map("ai_uncertain")
  REPEATED_FAILURE         @map("repeated_failure")
  COMPLAINT                @map("complaint")
  REFUND_REQUEST           @map("refund_request")
  EXCHANGE_REQUEST         @map("exchange_request")
  ORDER_PROBLEM            @map("order_problem")
  PAYMENT_PROBLEM          @map("payment_problem")
  UNAVAILABLE_PRODUCT      @map("unavailable_product")
  COMPLEX_QUESTION         @map("complex_question")
  ABUSIVE_CUSTOMER         @map("abusive_customer")
  OTHER                    @map("other")
}

enum HandoverStatus {
  PENDING   @map("pending")
  ASSIGNED  @map("assigned")
  RESOLVED  @map("resolved")
  CANCELLED @map("cancelled")
}

model ConversationHandover {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  reason         HandoverReason
  note           String?          @db.Text
  status         HandoverStatus   @default(PENDING)
  assignedTo     String?          @map("assigned_to") @db.VarChar(100)
  createdBy      String           @map("created_by") @db.VarChar(100)
  createdAt      DateTime         @default(now()) @map("created_at")
  resolvedAt     DateTime?        @map("resolved_at")
  resolvedBy     String?          @map("resolved_by") @db.VarChar(100)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  notifications  AdminNotification[]

  @@index([status, createdAt])
  @@index([assignedTo, status, createdAt])
  @@index([conversationId, createdAt])
  @@map("conversation_handovers")
}

model AdminNotification {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  handoverId     String?               @map("handover_id") @db.Uuid
  type           String                @db.VarChar(100)
  message        String                @db.VarChar(500)
  readAt         DateTime?             @map("read_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  handover       ConversationHandover? @relation(fields: [handoverId], references: [id], onDelete: SetNull)

  @@index([readAt, createdAt])
  @@index([conversationId, createdAt])
  @@map("admin_notifications")
}

enum MessengerEventStatus {
  RECEIVED        @map("received")
  QUEUED          @map("queued")
  PROCESSING      @map("processing")
  PROCESSED       @map("processed")
  DELIVERY_FAILED @map("delivery_failed")
  FAILED          @map("failed")
  IGNORED         @map("ignored")
}

model MessengerEventLog {
  id                     String               @id @default(uuid()) @db.Uuid
  externalEventId        String               @unique @map("external_event_id") @db.VarChar(255)
  externalMessageId      String?              @map("external_message_id") @db.VarChar(255)
  eventType              String               @map("event_type") @db.VarChar(100)
  pageId                 String               @map("page_id") @db.VarChar(100)
  senderId               String?              @map("sender_id") @db.VarChar(100)
  status                 MessengerEventStatus @default(RECEIVED)
  localOutboundMessageId String?              @map("local_outbound_message_id") @db.Uuid
  errorMessage           String?              @map("error_message") @db.VarChar(500)
  receivedAt             DateTime             @default(now()) @map("received_at")
  processedAt            DateTime?            @map("processed_at")

  @@index([status, receivedAt])
  @@index([pageId, receivedAt])
  @@index([externalMessageId])
  @@map("messenger_event_logs")
}

enum OrderStatus {
  DRAFT                 @map("draft")
  AWAITING_INFORMATION  @map("awaiting_information")
  AWAITING_CONFIRMATION @map("awaiting_confirmation")
  CONFIRMED             @map("confirmed")
  SUBMITTED             @map("submitted")
  COMPLETED             @map("completed")
  FAILED                @map("failed")
  ABANDONED             @map("abandoned")
  EXPIRED               @map("expired")
  CANCELLED             @map("cancelled")
  RETURNED              @map("returned")
}

enum OrderConfirmationStatus {
  NOT_REQUESTED @map("not_requested")
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
  REJECTED  @map("rejected")
}

enum OrderSource {
  AI        @map("ai")
  TEST      @map("test")
  MESSENGER @map("messenger")
  WEB       @map("web")
}

enum DeliveryLocation {
  DHAKA         @map("dhaka")
  OUTSIDE_DHAKA @map("outside_dhaka")
}

enum OrderSubmissionResult {
  NOT_ATTEMPTED @map("not_attempted")
  IN_PROGRESS   @map("in_progress")
  SUCCEEDED     @map("succeeded")
  KNOWN_FAILURE @map("known_failure")
  UNKNOWN       @map("unknown")
}

model Order {
  id                 String                  @id @default(uuid()) @db.Uuid
  orderCode          String?                 @map("order_code") @db.VarChar(100)
  customerId         String                  @map("customer_id") @db.Uuid
  conversationId     String                  @map("conversation_id") @db.Uuid
  status             OrderStatus             @default(DRAFT)
  confirmationStatus OrderConfirmationStatus @default(PENDING) @map("confirmation_status")
  confirmationText   String?                 @map("confirmation_text") @db.VarChar(100)
  confirmedAt        DateTime?               @map("confirmed_at")
  source             OrderSource             @default(AI)
  deliveryLocation   DeliveryLocation?       @map("delivery_location")
  totalQuantity      Int                     @default(0) @map("total_quantity")
  subtotal           Decimal                 @default(0) @db.Decimal(12, 2)
  deliveryCharge     Decimal                 @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  totalAmount        Decimal                 @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency           String                  @default("BDT") @db.VarChar(3)
  externalOrderId    String?                 @unique @map("external_order_id") @db.VarChar(255)
  externalResponse   Json?                   @map("external_response") @db.JsonB
  customerSnapshot   Json                    @map("customer_snapshot") @db.JsonB
  draftContext       Json?                   @map("draft_context") @db.JsonB
  submissionReference String                 @unique @default(uuid()) @map("submission_reference") @db.Uuid
  submissionResult   OrderSubmissionResult   @default(NOT_ATTEMPTED) @map("submission_result")
  submissionAttemptedAt DateTime?             @map("submission_attempted_at")
  failureCode        String?                  @map("failure_code") @db.VarChar(100)
  failureMessage     String?                  @map("failure_message") @db.VarChar(500)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  customer           Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conversation       Conversation             @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  activities         CustomerActivity[]
  followUps          FollowUp[]

  @@index([customerId, createdAt])
  @@index([conversationId, status, updatedAt])
  @@index([status, createdAt])
  @@index([submissionResult, updatedAt])
  @@map("orders")
}

model OrderItem {
  id                 String           @id @default(uuid()) @db.Uuid
  orderId            String           @map("order_id") @db.Uuid
  productId          String           @map("product_id") @db.Uuid
  variationId        String           @map("variation_id") @db.Uuid
  websiteProductId   Int              @map("website_product_id")
  websiteVariationId Int              @map("website_variation_id")
  productName        String           @map("product_name") @db.VarChar(255)
  productCode        String           @map("product_code") @db.VarChar(100)
  variationSize      String           @map("variation_size") @db.VarChar(50)
  quantity           Int
  unitPrice          Decimal          @map("unit_price") @db.Decimal(12, 2)
  lineTotal          Decimal          @map("line_total") @db.Decimal(12, 2)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variation          ProductVariation @relation(fields: [variationId], references: [id], onDelete: Restrict)

  @@unique([orderId, variationId])
  @@index([orderId])
  @@index([productId])
  @@index([variationId])
  @@index([websiteProductId])
  @@map("order_items")
}

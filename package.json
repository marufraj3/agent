{
  "name": "alzeena-sales-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Alzeena Fashion AI sales agent foundation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "prisma": {
    "schema": "packages/database/prisma/schema.prisma",
    "seed": "npm run db:seed"
  },
  "scripts": {
    "dev:api": "npm run build --workspace=@alzeena/database && npm run dev --workspace=@alzeena/api",
    "dev:worker": "npm run build --workspace=@alzeena/database && npm run dev:worker --workspace=@alzeena/api",
    "dev:web": "npm run dev --workspace=@alzeena/web",
    "build": "npm run build --workspace=@alzeena/database && npm run build --workspace=@alzeena/api && npm run build --workspace=@alzeena/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@alzeena/api",
    "verify:product-sync": "npm run verify:product-sync --workspace=@alzeena/api",
    "prisma:generate": "npm run prisma:generate --workspace=@alzeena/database",
    "db:push": "npm run db:push --workspace=@alzeena/database",
    "db:migrate": "npm run db:migrate --workspace=@alzeena/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@alzeena/database",
    "db:seed": "npm run db:seed --workspace=@alzeena/database",
    "db:verify": "npm run db:verify --workspace=@alzeena/database",
    "db:studio": "npm run db:studio --workspace=@alzeena/database"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  }
}

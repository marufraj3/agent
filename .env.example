# Runtime
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
API_BODY_LIMIT_BYTES=1000000
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
ADMIN_API_RATE_LIMIT_PER_MINUTE=300
ADMIN_LOGIN_RATE_LIMIT_PER_15_MINUTES=10
ADMIN_SESSION_TTL_HOURS=12
AI_CUSTOMER_RATE_LIMIT_PER_MINUTE=30
SLOW_QUERY_LOG_MS=500

# Infrastructure
DATABASE_URL=postgresql://alzeena:alzeena_dev_password@localhost:5432/alzeena_agent?schema=public
REDIS_URL=redis://localhost:6379

# Protected admin operations and AI
ADMIN_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_TIMEOUT_MS=30000
AI_MAX_HISTORY_MESSAGES=8
AI_MAX_KNOWLEDGE_CHARS=12000
AI_MAX_SUMMARY_CHARS=4000
AI_MAX_PRODUCTS=5
AI_CONFIDENCE_HIGH=0.8
AI_CONFIDENCE_LOW=0.45
AI_TEST_RATE_LIMIT_PER_MINUTE=30
AI_MAX_CONSECUTIVE_FAILURES=2
INBOX_PAGE_SIZE=25
CONVERSATION_HISTORY_LIMIT=20
MAX_IMAGE_SIZE_MB=10
# Step 17 server-only queued vision settings
IMAGE_MAX_FILE_SIZE=10
IMAGE_MAX_DIMENSION=12000
IMAGE_REQUEST_TIMEOUT_MS=15000
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash-lite
VISION_TIMEOUT=30
IMAGE_MATCH_CANDIDATES=5
IMAGE_RETENTION_HOURS=0
IMAGE_MATCH_HIGH_THRESHOLD=0.85
IMAGE_MATCH_MEDIUM_THRESHOLD=0.65
MAX_AUDIO_SIZE_MB=15
MAX_AUDIO_DURATION_SECONDS=120
AUDIO_REQUEST_TIMEOUT_MS=20000
VOICE_TRANSCRIPTION_LOW_CONFIDENCE=0.6
# Server-only speech-to-text settings. STT_MAX_FILE_SIZE is in MB; STT_TIMEOUT is seconds.
STT_PROVIDER=gemini
STT_MODEL=gemini-2.5-flash-lite
STT_TIMEOUT=30
STT_MAX_FILE_SIZE=15
STT_MAX_DURATION=120
# Source audio is deleted/unlinked after transcription by default. Set a short window for admin debugging.
AUDIO_RETENTION_HOURS=0
AUDIO_DEBOUNCE_MS=1500
AUDIO_RATE_LIMIT_PER_MINUTE=100
ORDER_API_TIMEOUT_MS=15000

# Facebook Messenger / Meta Webhooks (server-side secrets only)
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Central Meta Graph API version; FACEBOOK_GRAPH_API_VERSION remains a backward-compatible fallback.
META_GRAPH_API_VERSION=v25.0
FACEBOOK_GRAPH_API_VERSION=v25.0
FACEBOOK_SEND_TIMEOUT_MS=15000
APP_URL=http://localhost:4000
# Optional explicit public tunnel/production callback. Defaults to APP_URL/api/webhooks/facebook.
WEBHOOK_URL=
MESSENGER_PROVIDER=meta
# Required only when storing per-page encrypted tokens in the database (32+ random characters).
MESSENGER_CREDENTIAL_ENCRYPTION_KEY=
MESSENGER_DEBOUNCE_MS=1200
MESSENGER_WORKER_CONCURRENCY=5
MESSENGER_SEND_WORKER_CONCURRENCY=10
IMAGE_WORKER_CONCURRENCY=3
AUDIO_WORKER_CONCURRENCY=3
PRODUCT_SYNC_WORKER_CONCURRENCY=1
FOLLOWUP_WORKER_CONCURRENCY=2
PRODUCT_CACHE_TTL_SECONDS=60
RECOMMENDATION_ENABLED=true
RECOMMENDATION_MAX_PRODUCTS=3
RECOMMENDATION_CROSS_SELL_ENABLED=true
RECOMMENDATION_UPSELL_ENABLED=true
RECOMMENDATION_CACHE_TTL_SECONDS=60
SALES_INTELLIGENCE_CACHE_TTL_SECONDS=60
MESSENGER_TECHNICAL_LOG_RETENTION_DAYS=30
MESSENGER_WEBHOOK_RATE_LIMIT_PER_MINUTE=1000

# Product feed
WEBSITE_API_BASE_URL=https://sells.alzeena.com.bd/public/api
PRODUCT_FEED_TIMEOUT_MS=30000
PRODUCT_FEED_RETRIES=3
PRODUCT_FEED_MAX_PAGES=1000
